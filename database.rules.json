        "organiserId": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "requestId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "$other": { ".validate": false }
      }
    },
    "posterEventRequests": {
      /* A resident asking to organise a poster event. Private: an
         administrator reads them all, a resident only their own (by querying
         on userId). Filed as "pending" in the requester's own name, once
         every thirty seconds. Nothing is published from here — approving
         creates the event in posterEvents in the same write, and only then
         does it reach the Notice Board. The requester may withdraw a pending
         request; an administrator decides, and may delete any. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && (root.child('admins').child(auth.uid).val() === true || (query.orderByChild === 'userId' && query.equalTo === auth.uid))",
      ".indexOn": ["userId", "status", "createdAt"],
      "$rid": {
        ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && data.child('userId').val() === auth.uid",
        ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('userId').val() === auth.uid && newData.parent().parent().child('posterEventReqThrottle').child(auth.uid).val() === now) || (data.exists() && !newData.exists() && data.child('userId').val() === auth.uid && data.child('status').val() === 'pending'))",
        ".validate": "newData.hasChildren(['userId','name','institution','email','position','title','topic','description','startAt','endAt','venue','responsibilities','status','createdAt']) && newData.child('endAt').val() > newData.child('startAt').val()",
        "userId": { ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())" },
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80 && (!data.exists() || newData.val() === data.val())" },
        "institution": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120 && (!data.exists() || newData.val() === data.val())" },
        "email": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 200 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/) && (!data.exists() || newData.val() === data.val())" },
        "position": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80 && (!data.exists() || newData.val() === data.val())" },
        "title": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 160 && (!data.exists() || newData.val() === data.val())" },
        "topic": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 160 && (!data.exists() || newData.val() === data.val())" },
        "description": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 3000 && (!data.exists() || newData.val() === data.val())" },
        "startAt": { ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() > now))" },
        "endAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        "deadline": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        "venue": { ".validate": "(newData.val() === 'poster-hall' || newData.val() === 'poster-hall-2' || newData.val() === 'both' || newData.val() === 'virtual' || newData.val() === 'other') && (!data.exists() || newData.val() === data.val())" },
        "venueDetail": { ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 300 && (!data.exists() || newData.val() === data.val())" },
        "posters": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 62 && newData.val() % 1 === 0 && (!data.exists() || newData.val() === data.val())" },
        "comp": { ".validate": "newData.isBoolean() && (!data.exists() || newData.val() === data.val())" },
        "abstract": { ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 1500 && (!data.exists() || newData.val() === data.val())" },
        "extra": { ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 2000 && (!data.exists() || newData.val() === data.val())" },
        "responsibilities": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000 && (!data.exists() || newData.val() === data.val())" },
        "other": { ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 2000 && (!data.exists() || newData.val() === data.val())" },
        "tz": { ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 64 && (!data.exists() || newData.val() === data.val())" },
        "status": { ".validate": "(!data.exists() && newData.val() === 'pending') || (data.exists() && newData.val() === data.val()) || (root.child('admins').child(auth.uid).val() === true && data.val() === 'pending' && newData.val() === 'rejected') || (root.child('admins').child(auth.uid).val() === true && data.val() === 'pending' && newData.val() === 'approved' && newData.parent().parent().parent().child('posterEvents').child(newData.parent().child('eventId').val() + '').child('requestId').val() === $rid)" },
        "createdAt": { ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || newData.val() === data.val())" },
        "decidedAt": { ".validate": "newData.isNumber() && newData.parent().child('status').val() !== 'pending' && ((!data.exists() && newData.val() === now) || newData.val() === data.val())" },
        "decidedBy": { ".validate": "newData.isString() && newData.parent().child('status').val() !== 'pending' && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())" },
        "eventId": { ".validate": "newData.isString() && newData.val().length <= 64 && ((!data.exists() && root.child('admins').child(auth.uid).val() === true) || newData.val() === data.val())" },
        "note": { ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 500 && root.child('admins').child(auth.uid).val() === true" },
        "$other": { ".validate": false }
      }
    },
    "posterEventRequestPdfs": {
      /* The PDF made from a request when it was sent, kept apart so that
         listing the requests does not download every PDF. Written once, by
         the requester, alongside a request of theirs; read by them and the
         administrators; gone with the request. */
      "$rid": {
        ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && (root.child('admins').child(auth.uid).val() === true || root.child('posterEventRequests').child($rid).child('userId').val() === auth.uid)",
        ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.exists() && newData.parent().parent().child('posterEventRequests').child($rid).child('userId').val() === auth.uid) || (data.exists() && !newData.exists() && root.child('posterEventRequests').child($rid).child('userId').val() === auth.uid && !newData.parent().parent().child('posterEventRequests').child($rid).exists()))",
        ".validate": "newData.hasChildren(['d','at'])",
        "d": { ".validate": "newData.isString() && newData.val().length <= 600000 && newData.val().beginsWith('data:application/pdf;base64,')" },
        "at": { ".validate": "newData.isNumber() && newData.val() === now" },
        "$other": { ".validate": false }
      }
    },
    "posterEventReqThrottle": {
      /* One poster event request every thirty seconds per resident. */
      "$uid": {
        ".read": "auth.provider === 'password' && auth.uid == $uid",
        ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && auth.uid == $uid && newData.exists() && (!data.exists() || data.val() <= now - 30000)",
        ".validate": "newData.isNumber() && newData.val() === now"
      }
    },
    "posterRegs": {
      /* One registration per resident per event, filed under their uid, so
         registering twice cannot take a second stand. It carries the stand
         it was given (hallId, num), and posterSlots points back at it: each
         is only valid if the other agrees, in the same write. A resident may
         register while the event is open and before its deadline, edit their
         own wording afterwards, and cancel, which must free the stand in the
         same write. Only an administrator can change the stand, the status,
         or anyone else's registration. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$eid": {
        ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && root.child('admins').child(auth.uid).val() === true",
        "$uid": {
          ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && (root.child('admins').child(auth.uid).val() === true || (auth.uid == $uid && ((!data.exists() && newData.exists() && root.child('posterEvents').child($eid).child('status').val() === 'open' && root.child('posterEvents').child($eid).child('endAt').val() > now && (!root.child('posterEvents').child($eid).child('deadline').exists() || root.child('posterEvents').child($eid).child('deadline').val() > now)) || (data.exists() && newData.exists()) || (data.exists() && !newData.exists() && !newData.parent().parent().parent().child('posterSlots').child($eid).child(data.child('hallId').val()).child(data.child('num').val() + '').exists()))))",
          ".validate": "newData.hasChildren(['uid','name','institution','position','title','mode','hallId','num','status','createdAt'])",
          "uid": { ".validate": "newData.val() === $uid" },
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
          "institution": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
          "position": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
          "affiliation": { ".validate": "newData.isString() && newData.val().length <= 160" },
          "title": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
          "abstract": { ".validate": "newData.isString() && newData.val().length <= 1500" },
          "mode": { ".validate": "newData.val() === 'presentation' || (newData.val() === 'competition' && (root.child('posterEvents').child($eid).child('allowComp').val() === true || newData.val() === data.val()))" },
          "hallId": { ".validate": "(newData.val() === 'poster-hall' || newData.val() === 'poster-hall-2') && (!data.exists() || newData.val() === data.val() || root.child('admins').child(auth.uid).val() === true)" },
          "num": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && (!data.exists() || newData.val() === data.val() || root.child('admins').child(auth.uid).val() === true) && ((newData.val() === 0 && newData.parent().child('status').val() === 'rejected') || (newData.val() >= 1 && newData.parent().parent().parent().parent().child('posterSlots').child($eid).child(newData.parent().child('hallId').val()).child(newData.val() + '').val() === $uid && ((data.exists() && newData.val() === data.val() && newData.parent().child('hallId').val() === data.parent().child('hallId').val()) || (newData.parent().child('hallId').val() === 'poster-hall' && newData.val() <= root.child('posterEvents').child($eid).child('cap1').val()) || (newData.parent().child('hallId').val() === 'poster-hall-2' && newData.val() <= root.child('posterEvents').child($eid).child('cap2').val()))))" },
          "status": { ".validate": "(!data.exists() && ((newData.val() === 'pending' && root.child('posterEvents').child($eid).child('needsApproval').val() === true) || (newData.val() === 'registered' && root.child('posterEvents').child($eid).child('needsApproval').val() !== true))) || (data.exists() && newData.val() === data.val()) || (root.child('admins').child(auth.uid).val() === true && (newData.val() === 'pending' || newData.val() === 'registered' || newData.val() === 'approved' || newData.val() === 'rejected'))" },
          "createdAt": { ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || newData.val() === data.val())" },
          "updatedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "posterSlots": {
      /* posterSlots/<event>/<hall>/<number> = the uid holding that stand.
         A number is only ever taken if nobody holds it, so two residents
         registering at the same instant can never share one: the second
         write is refused and the page tries the next number. The number is
         only valid if the holder's registration names exactly this hall and
         number, which also keeps it within the hall's capacity. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$eid": {
        ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && root.child('admins').child(auth.uid).val() === true",
        "$hall": {
          "$num": {
            ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists() && !newData.parent().parent().parent().parent().child('posterRegs').child($eid).child(auth.uid).exists()))",
            ".validate": "newData.isString() && ($hall === 'poster-hall' || $hall === 'poster-hall-2') && newData.parent().parent().parent().parent().child('posterRegs').child($eid).child(newData.val()).child('hallId').val() === $hall && newData.parent().parent().parent().parent().child('posterRegs').child($eid).child(newData.val()).child('num').val() + '' === $num"
          }
        }
      }
    },
    "posterRegPosters": {
      /* The poster a registered participant pins to their own stand. Only
         they may put it up or change it, and only while they hold a stand;
         they or an administrator may take it down. Kept until then — it does
         not leave with its author the way an ordinary pinned poster does. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$eid": {
        ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && root.child('admins').child(auth.uid).val() === true",
        "$uid": {
          ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && ((root.child('admins').child(auth.uid).val() === true && !newData.exists()) || (auth.uid == $uid && (!newData.exists() || (root.child('posterRegs').child($eid).child($uid).child('num').val() >= 1 && root.child('posterRegs').child($eid).child($uid).child('status').val() !== 'rejected'))))",
          ".validate": "newData.hasChildren(['s','at'])",
          "s": { ".validate": "newData.isString() && newData.val().length <= 950000 && newData.val().beginsWith('data:image/')" },
          "t": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "at": { ".validate": "newData.isNumber() && newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "slides": {
      /* The page a seminar hall is looking at right now, filed under whoever
         is presenting. Only ever one page — the PDF itself never leaves the
         presenter's browser — and armed with the same disconnect hook as the
         chalk, so a hall empties its screen when the presenter leaves. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$room": {
        "$uid": {
          ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && auth.uid == $uid && (!newData.exists() || root.child('pins').child('boards').child($room).child('u').val() === auth.uid)",
          ".validate": "newData.hasChildren(['s','i','n','at'])",
          "s": {
            ".validate": "newData.isString() && newData.val().length <= 900000"
          },
          "i": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5000"
          },
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5000"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "u": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "posterLikes": {
      /* One durable like per signed-in resident and poster. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$frame": {
        "$uid": {
          ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && auth.uid == $uid",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },
    "voiceLive": {
      /* Who is speaking right now. Speech itself never comes through this
         database: the audio rides a WebRTC connection straight between the two
         browsers, and all that is kept here is a four-field note saying that
         somebody is talking and where they stand, so listeners in earshot know
         to open a connection. Each note carries onDisconnect().remove(), and is
         deleted the moment the speaker stops. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$uid": {
        ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && (auth.uid == $uid || (!newData.exists() && root.child('admins').child(auth.uid).val() === true))",
        ".validate": "!newData.exists() || newData.hasChildren(['n','mode','at'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "mode": {
          ".validate": "newData.isString() && (newData.val() === 'nearby' || newData.val() === 'village')"
        },
        "x": {
          ".validate": "newData.isNumber()"
        },
        "z": {
          ".validate": "newData.isNumber()"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "voiceSignal": {
      /* WebRTC handshakes, addressed to a recipient. Anyone signed in may leave
         an offer, an answer or an ICE candidate in somebody's inbox, and only
         the owner of the inbox may read it — which they do once, deleting it in
         the same breath. Nothing here outlives the few hundred milliseconds a
         connection takes to come up, and none of it is audio. */
      "$to": {
        ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && auth.uid == $to",
        ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && auth.uid == $to",
        "$from": {
          ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && auth.uid == $from",
          "$msg": {
            ".validate": "!newData.exists() || newData.hasChildren(['t'])",
            "t": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "d": {
              ".validate": "newData.isString() && newData.val().length <= 20000"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "dm": {
      /* Private messages. One thread per pair, keyed "<a>~<b>" with a < b, and
         only those two residents may read it or add to it. A message is
         written once and never edited; either participant may delete one
         (which is how month-old messages are tidied). Firebase uids never
         contain "~", so the key cannot be forged to include a third party. */
      "$pair": {
        ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && ($pair.beginsWith(auth.uid + '~') || $pair.endsWith('~' + auth.uid))",
        "$msg": {
          ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && ($pair.beginsWith(auth.uid + '~') || $pair.endsWith('~' + auth.uid)) && (!data.exists() || !newData.exists())",
          ".validate": "!newData.exists() || newData.hasChildren(['f','m','at'])",
          "f": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "m": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "dmInbox": {
      /* "You have a private message from ...": set by the sender, read and
         cleared only by the recipient. Nobody else can see who is writing to
         whom. */
      "$to": {
        ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && auth.uid == $to",
        "$from": {
          ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && $from != $to && (auth.uid == $from || (auth.uid == $to && !newData.exists()))",
          ".validate": "!newData.exists() || newData.hasChildren(['n','at'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "p": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "activities": {
      /* What is happening in the village right now: a blackboard discussion, a
         seminar, a poster going up. One record per organiser, filed under their
         uid, carrying the topic and the place so the announcement can say
         "Blackboard discussion on Dark Photons — Seminar Room Alpha" and offer
         to walk you there. Armed with onDisconnect().remove(), so an activity
         ends when its organiser leaves whether or not they remember to end it. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$uid": {
        ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && (auth.uid == $uid || (!newData.exists() && root.child('admins').child(auth.uid).val() === true) || (data.exists() && !newData.exists() && data.child('at').val() < (now - 14400000)))",
        ".validate": "!newData.exists() || newData.hasChildren(['kind','at'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "kind": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "topic": {
          ".validate": "newData.isString() && newData.val().length <= 90"
        },
        "where": {
          ".validate": "newData.isString() && newData.val().length <= 48"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "x": {
          ".validate": "newData.isNumber()"
        },
        "z": {
          ".validate": "newData.isNumber()"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
