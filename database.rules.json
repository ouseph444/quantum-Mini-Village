/* Quantum Village — Realtime Database rules. Presence, chat, announcements and
   room claims live here because they change several times a second and would be
   expensive in Firestore. Deploy with: firebase deploy --only database — or
   paste this file into Firebase console → Realtime Database → Rules. */

/* The village is walled: every read and write needs an account with a password
   (auth.provider === 'password') that is not on the blocked list. Anonymous
   sign-in must be DISABLED in the console. Enable Authentication → Sign-in
   method → Email/Password, and disable Anonymous and Google. */

{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      /* Who may administer the village. Readable by anyone signed in, so the
         page knows whether to show the panel — and writable by NOBODY from a
         browser. The only way to appoint an administrator is the Firebase
         console (Realtime Database → Data → add admins/<uid>: true) or a server
         holding a service-account key. An administrator cannot be appointed by
         the page that checks for one, which is the whole point. */
      ".read": "auth.provider === 'password'",
      ".write": false,
      "$uid": {
        ".validate": "newData.isBoolean()"
      }
    },
    "blocked": {
      /* Residents who are barred. Every other rule in this file refuses a
         request whose auth.uid appears here, so a blocked account may still hold
         a valid token, may still open the page, and will not be given one byte
         of the village nor be allowed to write one. Only an administrator may
         add or remove an entry. Deliberately NOT guarded by the block check
         itself: somebody who has been blocked must still be able to read their
         own record to be told so, and an administrator who blocks themselves
         must still be able to undo it. */
      ".read": "auth.provider === 'password' && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth.provider === 'password' && (auth.uid == $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth.provider === 'password' && root.child('admins').child(auth.uid).val() === true",
        ".validate": "!newData.exists() || newData.hasChildren(['at','by'])",
        "at": {
          ".validate": "newData.isNumber()"
        },
        "by": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "byName": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "why": {
          ".validate": "newData.isString() && newData.val().length <= 140"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "presence": {
      /* One record per resident: where they are, what they are doing. Removed by
         onDisconnect when a tab closes; a record left behind by a crash may be
         deleted by anyone once it is five minutes stale. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$uid": {
        ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && (auth.uid == $uid || (!newData.exists() && root.child('admins').child(auth.uid).val() === true) || (data.exists() && !newData.exists() && data.child('at').val() < (now - 300000)))",
        ".validate": "newData.hasChildren(['n','x','z','at'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "x": {
          ".validate": "newData.isNumber()"
        },
        "z": {
          ".validate": "newData.isNumber()"
        },
        "r": {
          ".validate": "newData.isNumber()"
        },
        "p": {
          ".validate": "newData.isString() && newData.val().length <= 48"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "l": {
          ".validate": "newData.hasChildren()"
        },
        "rm": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "st": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "si": {
          ".validate": "newData.isNumber()"
        },
        "cy": {
          ".validate": "newData.isBoolean()"
        },
        "af": {
          ".validate": "newData.isString() && newData.val().length <= 90"
        },
        "co": {
          ".validate": "newData.isString() && newData.val().length <= 56"
        },
        "oi": {
          ".validate": "newData.isString() && newData.val().length <= 19"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "chat": {
      /* Village talk, and nothing more: a line lives here only until the people
         who are online have read it. The author pushes it with an
         onDisconnect().remove() hook, readers acknowledge under seen/, and the
         author deletes it once everybody present has acknowledged or after
         forty-five seconds, whichever comes first. There is no history to read
         and nothing to prune. Ordinary talk carries about seventy paces; an
         announcement (a:true) carries to everyone. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$msg": {
        ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && (!data.exists() || data.child('uid').val() == auth.uid)",
        ".validate": "newData.hasChildren(['n','m','at'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "m": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "uid": {
          ".validate": "newData.val() == auth.uid"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "seen": {
          /* Read receipts. Every reader writes their own uid here once the line
             is on screen; the author watches this list and deletes the whole
             message as soon as everybody present has read it. That is the only
             reason the village keeps a message at all. */
          "$uid": {
            ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && auth.uid == $uid",
            ".validate": "!newData.exists() || newData.val() === true"
          }
        },
        "$other": {
          ".validate": false
        },
        "x": {
          ".validate": "newData.isNumber()"
        },
        "z": {
          ".validate": "newData.isNumber()"
        },
        "a": {
          ".validate": "newData.isBoolean()"
        }
        /* x and z are where the speaker stood, so clients can drop anything out
           of earshot; a marks an announcement, which everyone hears wherever
           they are. */
      }
    },
    "events": {
      /* Announcements: an institute founded, a seminar called. Write once, never
         edit. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$evt": {
        ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && !data.exists()",
        ".validate": "newData.hasChildren(['kind','at'])",
        "kind": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "where": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      /* Who is sitting where, and who has the blackboard. Each claim is { u:
         uid, t: when }. A claim may be taken only if the slot is free, already
         yours, or more than an hour stale — which is the safety net for a client
         that died without its onDisconnect firing. Clients claim with a
         transaction, so two people pressing E on the same chair cannot both get
         it. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$room": {
        "seats": {
          "$seat": {
            ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && (!data.exists() || data.child('u').val() == auth.uid || data.child('t').val() < (now - 3600000))",
            ".validate": "newData.hasChildren(['u','t'])",
            "u": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= (now + 60000)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "speaker": {
          ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && (!data.exists() || data.child('u').val() == auth.uid || data.child('t').val() < (now - 3600000))",
          ".validate": "newData.hasChildren(['u','t'])",
          "u": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= (now + 60000)"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "boards": {
      /* Chalk and pinned pictures, filed under whoever wrote them. Every entry
         carries a disconnect hook client-side, so this tree empties itself as
         people leave; nothing here is meant to survive a session. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$board": {
        "$uid": {
          ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && auth.uid == $uid",
          ".validate": "newData.hasChildren(['at'])",
          "s": {
            ".validate": "newData.isString() && newData.val().length <= 1200"
          },
          "p": {
            ".validate": "newData.isString() && newData.val().length <= 900000 && (newData.val() === '' || root.child('pins').child('boards').child($board).child('u').val() === auth.uid)"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "pins": {
      /* Who holds each poster stand and each blackboard. One document per
         surface: the first to claim it keeps it until they take their
         document down or leave (the claim carries a disconnect hook), and
         until then nobody else may claim it. The posters, slides and board
         pictures above are only accepted from the holder. An administrator
         may clear a claim, for moderation. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$kind": {
        "$id": {
          ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && ($kind === 'posters' || $kind === 'boards') && ((!data.exists() && newData.child('u').val() === auth.uid) || (data.child('u').val() === auth.uid && (!newData.exists() || newData.child('u').val() === auth.uid)) || (!newData.exists() && root.child('admins').child(auth.uid).val() === true) || (data.child('expiresAt').isNumber() && data.child('expiresAt').val() <= now && (!newData.exists() || newData.child('u').val() === auth.uid)) || (data.hasChild('competitionId') && root.child('posterCompetitions').child(data.child('competitionId').val()).child('status').val() !== 'active' && (!newData.exists() || newData.child('u').val() === auth.uid)))",
          ".validate": "newData.hasChildren(['u','at']) && newData.hasChild('competitionId') === newData.hasChild('expiresAt')",
          "u": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          /* A stand taken for a poster competition. The claim has no
             disconnect hook and lasts until the competition ends — exactly
             approvedAt + 24 h, which is the only expiry accepted — and then
             anybody may clear it or take the stand. */
          "competitionId": {
            ".validate": "$kind === 'posters' && newData.isString() && root.child('posterCompetitions').child(newData.val()).child('status').val() === 'active' && root.child('posterCompetitions').child(newData.val()).child('approvedAt').isNumber() && root.child('posterCompetitions').child(newData.val()).child('approvedAt').val() > now - 86400000 && (($id.beginsWith('poster-hall-2-') && root.child('posterHallCompetition/poster-hall-2/id').val() === newData.val()) || (!$id.beginsWith('poster-hall-2-') && $id.beginsWith('poster-hall-') && root.child('posterHallCompetition/poster-hall/id').val() === newData.val()))"
          },
          "expiresAt": {
            ".validate": "newData.isNumber() && newData.val() === root.child('posterCompetitions').child(newData.parent().child('competitionId').val()).child('approvedAt').val() + 86400000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "posters": {
      /* One poster per board per author, as a compressed data URL. Same
         disconnect hook, same rule: it goes when its author does.

         Except during a poster competition. A poster pinned while its hall
         has an approved, unexpired competition must carry competitionId,
         hallId and expiresAt; the rules check all three against the
         competition, the hall and the stand's claim, and accept only
         expiresAt = approvedAt + 24 h. The client pins it without a
         disconnect hook, so it stays up after its author leaves, and once
         expiresAt has passed anybody may sweep it. An ordinary poster
         cannot be turned into a competition poster in place, and a new
         ordinary poster cannot go up in a hall while a competition runs. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$frame": {
        "$uid": {
          ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && ((auth.uid == $uid && (!newData.exists() || root.child('pins').child('posters').child($frame).child('u').val() === auth.uid)) || (!newData.exists() && (root.child('admins').child(auth.uid).val() === true || (data.child('expiresAt').isNumber() && data.child('expiresAt').val() <= now) || (data.hasChild('competitionId') && root.child('posterCompetitions').child(data.child('competitionId').val()).child('status').val() !== 'active'))))",
          ".validate": "newData.hasChildren(['s','at']) && newData.hasChild('competitionId') === newData.hasChild('expiresAt') && newData.hasChild('competitionId') === newData.hasChild('hallId') && (!newData.hasChild('competitionId') || !data.exists() || data.hasChild('competitionId')) && (newData.hasChild('competitionId') || (data.exists() && !data.hasChild('competitionId')) || !(($frame.beginsWith('poster-hall-2-') && root.child('posterHallCompetition/poster-hall-2/approvedAt').isNumber() && root.child('posterHallCompetition/poster-hall-2/approvedAt').val() > now - 86400000) || (!$frame.beginsWith('poster-hall-2-') && $frame.beginsWith('poster-hall-') && root.child('posterHallCompetition/poster-hall/approvedAt').isNumber() && root.child('posterHallCompetition/poster-hall/approvedAt').val() > now - 86400000)))",
          "competitionId": {
            ".validate": "newData.isString() && root.child('pins').child('posters').child($frame).child('competitionId').val() === newData.val() && root.child('posterCompetitions').child(newData.val()).child('status').val() === 'active' && root.child('posterCompetitions').child(newData.val()).child('approvedAt').isNumber() && root.child('posterCompetitions').child(newData.val()).child('approvedAt').val() > now - 86400000 && root.child('posterCompetitions').child(newData.val()).child('hallId').val() === newData.parent().child('hallId').val() && root.child('posterHallCompetition').child(newData.parent().child('hallId').val()).child('id').val() === newData.val()"
          },
          "hallId": {
            ".validate": "newData.isString() && ((newData.val() === 'poster-hall-2' && $frame.beginsWith('poster-hall-2-')) || (newData.val() === 'poster-hall' && $frame.beginsWith('poster-hall-') && !$frame.beginsWith('poster-hall-2-')))"
          },
          "expiresAt": {
            ".validate": "newData.isNumber() && newData.val() === root.child('posterCompetitions').child(newData.parent().child('competitionId').val()).child('approvedAt').val() + 86400000"
          },
          "s": {
            ".validate": "newData.isString() && newData.val().length <= 900000"
          },
          "t": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "posterCompetitionRequests": {
      /* Asking for a 24-hour poster competition in a poster hall. Anybody
         signed in may ask, only in their own name, and only as "pending";
         they may withdraw a request while it is still pending. Only an
         administrator may approve or reject, and approval must create the
         competition in the same write (see posterCompetitions). Nothing
         the requester writes can set status, approvedAt or expiresAt. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      ".indexOn": ["status", "userId"],
      "$req": {
        ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && ((!data.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('userId').val() === auth.uid && data.child('status').val() === 'pending') || (root.child('admins').child(auth.uid).val() === true && (!newData.exists() || (data.exists() && data.child('status').val() === 'pending'))))",
        ".validate": "newData.hasChildren(['userId','userName','hallId','title','requestedAt','status'])",
        "userId": {
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
        },
        "userName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32 && (!data.exists() || newData.val() === data.val())"
        },
        "hallId": {
          ".validate": "(newData.val() === 'poster-hall' || newData.val() === 'poster-hall-2') && (!data.exists() || newData.val() === data.val())"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 90 && (!data.exists() || newData.val() === data.val())"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 500 && (!data.exists() || newData.val() === data.val())"
        },
        "preferredStart": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "fullName": {
          ".validate": "newData.isString() && newData.val().length <= 80 && (!data.exists() || newData.val() === data.val())"
        },
        "institution": {
          ".validate": "newData.isString() && newData.val().length <= 120 && (!data.exists() || newData.val() === data.val())"
        },
        "position": {
          ".validate": "newData.isString() && newData.val().length <= 80 && (!data.exists() || newData.val() === data.val())"
        },
        "requestedAt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || newData.val() === data.val())"
        },
        "status": {
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === 'pending') || newData.val() === data.val() || (data.val() === 'pending' && newData.val() === 'rejected' && root.child('admins').child(auth.uid).val() === true) || (data.val() === 'pending' && newData.val() === 'approved' && root.child('admins').child(auth.uid).val() === true && newData.parent().parent().parent().child('posterCompetitions').child($req).exists()))"
        },
        "approvedAt": {
          ".validate": "newData.isNumber() && newData.parent().child('status').val() === 'approved' && ((!data.exists() && newData.val() === now) || newData.val() === data.val())"
        },
        "expiresAt": {
            ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && !data.exists()",
            ".validate": "newData.isNumber() && newData.parent().child('approvedAt').isNumber() && newData.val() === newData.parent().child('approvedAt').val() + 86400000"
          },
        "decidedAt": {
          ".validate": "newData.isNumber() && newData.parent().child('status').val() !== 'pending' && ((!data.exists() && newData.val() === now) || newData.val() === data.val())"
        },
        "decidedBy": {
          ".validate": "newData.isString() && newData.parent().child('status').val() !== 'pending' && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "posterCompetitions": {
      /* An approved competition, keyed by the request it came from. Created
         only by an administrator, only together with approving that request
         and taking the hall (posterHallCompetition), and every field is
         copied from the request or stamped by the server. Nothing may be
         changed afterwards except, once approvedAt + 24 h has passed,
         status "active" → "expired" — which anybody may do, so that the
         village tidies itself up with or without a Cloud Function. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      ".indexOn": ["status"],
      "$comp": {
        ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && ((root.child('admins').child(auth.uid).val() === true && (!newData.exists() || !data.exists())) || (data.exists() && newData.exists() && data.child('approvedAt').isNumber() && data.child('approvedAt').val() <= now - 86400000) || (data.exists() && newData.exists() && data.child('status').val() === 'active' && (root.child('admins').child(auth.uid).val() === true || data.child('organiserId').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['requestId','hallId','title','organiserId','organiserName','status','approvedAt']) && (data.exists() || newData.parent().parent().child('posterHallCompetition').child(newData.child('hallId').val()).child('id').val() === $comp)",
        "requestId": {
          ".validate": "newData.val() === $comp"
        },
        "hallId": {
          ".validate": "(data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === root.child('posterCompetitionRequests').child($comp).child('hallId').val())"
        },
        "title": {
          ".validate": "(data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === root.child('posterCompetitionRequests').child($comp).child('title').val())"
        },
        "organiserId": {
          ".validate": "(data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === root.child('posterCompetitionRequests').child($comp).child('userId').val())"
        },
        "organiserName": {
          ".validate": "(data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === root.child('posterCompetitionRequests').child($comp).child('userName').val())"
        },
        "status": {
          ".validate": "(!data.exists() && newData.val() === 'active' && root.child('posterCompetitionRequests').child($comp).child('status').val() === 'pending' && newData.parent().parent().parent().child('posterCompetitionRequests').child($comp).child('status').val() === 'approved') || (data.exists() && newData.val() === data.val()) || (data.val() === 'active' && newData.val() === 'expired')"
        },
        "endedAt": {
          ".validate": "newData.isNumber() && newData.parent().child('status').val() === 'expired' && ((!data.exists() && newData.val() === now) || newData.val() === data.val())"
        },
        "endedBy": {
          ".validate": "newData.isString() && newData.parent().child('status').val() === 'expired' && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
        },
        "approvedAt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || newData.val() === data.val())"
        },
        "expiresAt": {
            ".write": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists() && !data.exists()",
            ".validate": "newData.isNumber() && newData.parent().child('approvedAt').isNumber() && newData.val() === newData.parent().child('approvedAt').val() + 86400000"
          },
        "$other": {
          ".validate": false
        }
      }
    },
    "posterHallCompetition": {
      /* The competition a poster hall is running, one at a time. Only an
         administrator may take a hall, only for a competition created in
         the same write, and only while the hall is free or its last
         competition is over — which is what stops two running in the same
         hall. Once approvedAt + 24 h has passed anybody may clear it. */
      ".read": "auth.provider === 'password' && !root.child('blocked').child(auth.uid).exists()",
      "$hall": {
